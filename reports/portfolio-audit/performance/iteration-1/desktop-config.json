{
  "extends": "lighthouse:default",
  "settings": {
    "onlyCategories": [
      "performance"
    ],
    "formFactor": "desktop",
    "screenEmulation": {
      "mobile": false,
      "width": 1440,
      "height": 900,
      "deviceScaleFactor": 1,
      "disabled": false
    },
    "throttlingMethod": "simulate",
    "throttling": {
      "rttMs": 40,
      "throughputKbps": 10240,
      "cpuSlowdownMultiplier": 1
    },
    "disableStorageReset": false
  }
}