{
  "extends": "lighthouse:default",
  "settings": {
    "onlyCategories": [
      "performance"
    ],
    "formFactor": "mobile",
    "screenEmulation": {
      "mobile": true,
      "width": 390,
      "height": 844,
      "deviceScaleFactor": 1.75,
      "disabled": false
    },
    "throttlingMethod": "simulate",
    "throttling": {
      "rttMs": 150,
      "throughputKbps": 1638.4,
      "cpuSlowdownMultiplier": 4
    },
    "disableStorageReset": false
  }
}