# Public site
NEXT_PUBLIC_SITE_URL=https://zqtion.com
# Enable only after migration 002 and the privacy/retention policy are approved.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Community V1: keep disabled until migrations 004-007, Auth and private Storage are configured.
NEXT_PUBLIC_COMMUNITY_ENABLED=false
# The NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY below power Auth and RLS reads.
# SUPABASE_SECRET_KEY is used server-side only for validated private-image storage.

# Inquiry storage (server only service key)
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
# Legacy projects can use SUPABASE_SERVICE_ROLE_KEY instead.
# Optional dedicated HMAC secret for hashing rate-limit keys. The Supabase secret is used as fallback.
RATE_LIMIT_SECRET=replace-with-a-long-random-server-only-value

# Inquiry transactional email (server only; verify zqtion.com in Resend)
# Keep Zoho inbound mail. Setup and recovery: docs/INQUIRY_EMAIL_SETUP.md
RESEND_API_KEY=your-server-only-resend-key
INQUIRY_FROM_EMAIL=Zqtion <info@zqtion.com>
INQUIRY_TO_EMAIL=info@zqtion.com

# Cloudflare Turnstile spam protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-public-site-key
TURNSTILE_SECRET_KEY=your-server-only-secret-key

# Launchpad stays closed until legal, supervision, privacy and delivery gates pass.
# Server-only switch; do not enable merely to publish the page.
LAUNCHPAD_APPLICATIONS_ENABLED=false
# Optional internal notification recipient. Applicant answers stay in private storage.
APPLICATION_TO_EMAIL=info@zqtion.com
# Offline research only. Never use a NEXT_PUBLIC_ prefix for this path.
ZQTION_PROMPT_CORPUS_PATH="E:\\projects\\zqtion-prompt-corpus"
