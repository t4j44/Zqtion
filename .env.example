# Public site
NEXT_PUBLIC_SITE_URL=https://zqtion.com
# Enable only after migration 002 and the privacy/retention policy are approved.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Inquiry storage (server only service key)
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
# Legacy projects can use SUPABASE_SERVICE_ROLE_KEY instead.
# Optional dedicated HMAC secret for hashing rate-limit keys. The Supabase secret is used as fallback.
RATE_LIMIT_SECRET=replace-with-a-long-random-server-only-value

# Inquiry email delivery (verify the sender domain in Resend)
RESEND_API_KEY=your-server-only-resend-key
INQUIRY_FROM_EMAIL=Zqtion Website <briefs@updates.zqtion.com>
INQUIRY_TO_EMAIL=zqtioncontact@gmail.com

# Cloudflare Turnstile spam protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-public-site-key
TURNSTILE_SECRET_KEY=your-server-only-secret-key

# Launchpad stays closed until legal, supervision, privacy and delivery gates pass.
# Server-only switch; do not enable merely to publish the page.
LAUNCHPAD_APPLICATIONS_ENABLED=false
# Optional internal notification recipient. Applicant answers stay in private storage.
APPLICATION_TO_EMAIL=zqtioncontact@gmail.com
